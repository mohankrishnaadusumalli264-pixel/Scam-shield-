# GEMINI_API_KEY: Required for server-side Gemini AI scam analysis calls.
# AI Studio automatically injects this at runtime from user secrets.
# Never expose this key in client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Cloud Run / AI Studio runtime).
APP_URL="http://localhost:3000"

# PORT: Listening port for the Express server (defaults to 3000).
PORT="3000"

# NODE_ENV: "development" or "production"
NODE_ENV="development"

# Firebase configuration is loaded from firebase-applet-config.json.
# Do NOT store private Firebase service-account JSON keys in client bundles.
